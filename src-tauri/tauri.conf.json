{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Note",
  "version": "../package.json",
  "identifier": "io.github.felix-d-git.pdf-note",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Note",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#0A100F"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "felix-d-git",
    "licenseFile": "../LICENSE",
    "resources": { "resources/tessdata/*": "tessdata/" }
  }
}
